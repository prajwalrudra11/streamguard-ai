# ============================================
# StreamGuard AI - Environment Configuration
# ============================================

# Supabase
SUPABASE_URL=https://xehdddyufulxxyoyavyw.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# IBM watsonx / IBM Granite AI Engine (Primary Engine)
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
IBM_GRANITE_MODEL=ibm/granite-3-8b-instruct
IBM_BOB_API_KEY=your-ibm-bob-api-key

# Fallback AI Provider (Optional)
GEMINI_API_KEY=your-gemini-api-key

# YouTube API (Phase 3)
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Voice Matching
VOICE_MATCH_THRESHOLD=0.70
VOICE_COOLDOWN_SECONDS=5

# Agent Settings
MODERATION_STRICT_MODE=false
MAX_QUEUE_SIZE=500
